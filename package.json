{
  "name": "@alicloud/openclaw-security-assistant",
  "version": "1.0.0",
  "description": "Security assistant plugin by Alibaba Cloud that provides LLM request/response protection, tool call security checks.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliyun/openclaw-security-assistant.git"
  },
  "keywords": [
    "openclaw",
    "security"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=bundle.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "README.md",
    "README.en.md",
    "LICENSE",
    "bundle.js",
    "openclaw.plugin.json",
    "package.json"
  ],
  "openclaw": {
    "extensions": [
      "./bundle.js"
    ]
  },
  "devDependencies": {
    "esbuild": "^0.27.4"
  }
}
